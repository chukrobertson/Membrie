[Desktop Entry]
Type=Application
Name=Membrie
GenericName=Memory Companion
Comment=Remember and recall your activity privately
Exec=@MEMBRIE_EXEC@
TryExec=@MEMBRIE_EXEC@
Icon=com.chuk.Membrie
Terminal=false
Categories=Utility;
Keywords=memory;recall;notes;clipboard;local;
StartupNotify=true
Actions=QuickBrie;

[Desktop Action QuickBrie]
Name=Quick Brie
Exec=@MEMBRIE_EXEC@ --quick
