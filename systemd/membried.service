[Unit]
Description=Membrie local memory service
Documentation=https://github.com/chukrobertson/Membrie

[Service]
Type=simple
ExecStart=%h/.local/libexec/membrie/membried
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=default.target
