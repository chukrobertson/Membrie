[Unit]
Description=Membrie GNOME desktop capture service
Documentation=https://github.com/chukrobertson/Membrie
Requires=membried.service
After=membried.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/libexec/membrie/membrie-capture
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=graphical-session.target
